FROM apache/airflow:2.10.3

ENV AIRFLOW_HOME=/opt/airflow

# Set the user to root for administrative tasks
USER root

# Install system-level dependencies
RUN apt-get update -qq && apt-get install -y \
    vim \
    curl \
    wget \
    && apt-get clean

# Switch to airflow user for Python package installations
USER ${AIRFLOW_UID}

# Copy and install Python dependencies as the airflow user
COPY requirements.txt .
RUN pip install --no-cache-dir "apache-airflow==2.10.3" -r requirements.txt \
    && pip install --no-cache-dir pandas sqlalchemy psycopg2-binary

# Set the shell options for better error handling
SHELL ["/bin/bash", "-o", "pipefail", "-e", "-u", "-x", "-c"]

# Install dbt Core (BigQuery adapter) in an ISOLATED virtualenv so its dependencies
# never collide with Airflow's pinned set. DAGs invoke /opt/dbt-venv/bin/dbt via a
# BashOperator. Keep this version in sync with dbt/requirements.txt.
USER root
RUN python -m venv /opt/dbt-venv \
    && /opt/dbt-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/dbt-venv/bin/pip install --no-cache-dir dbt-bigquery==1.11.1

# Set the working directory and revert to airflow user
WORKDIR $AIRFLOW_HOME
USER ${AIRFLOW_UID}
